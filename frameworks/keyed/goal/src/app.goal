const adjectives = ['pretty', 'large', 'big', 'small', 'tall', 'short', 'long', 'handsome', 'plain', 'quaint', 'clean', 'elegant', 'easy', 'angry', 'crazy', 'helpful', 'mushy', 'odd', 'unsightly', 'adorable', 'important', 'inexpensive', 'cheap', 'expensive', 'fancy'];
const colours = ['red', 'yellow', 'blue', 'green', 'pink', 'brown', 'purple', 'brown', 'white', 'black', 'orange'];
const nouns = ['table', 'chair', 'house', 'bbq', 'desk', 'car', 'pony', 'cookie', 'sandwich', 'burger', 'pizza', 'mouse', 'keyboard'];

let nextId = 1;
const random = (max) => Math.round(Math.random() * 1000) % max;

function buildData(count) {
  const data = new Array(count);
  for (let i = 0; i < count; i++)
    data[i] = { id: nextId++, label: `${adjectives[random(adjectives.length)]} ${colours[random(colours.length)]} ${nouns[random(nouns.length)]}` };
  return data;
}

export function Main() {
  var rows = [];
  var selected = 0;

  function swap() {
    if (rows.length < 999) return;
    const next = rows.slice();
    next[1] = rows[998];
    next[998] = rows[1];
    rows = next;
  }

  return (
    <div class="container">
      <div class="jumbotron">
        <div class="row">
          <div class="col-md-6"><h1>goal.js-"keyed"</h1></div>
          <div class="col-md-6">
            <div class="row">
              <div class="col-sm-6 smallpad"><button type="button" class="btn btn-primary btn-block" id="run" onclick={() => (rows = buildData(1000))}>Create 1,000 rows</button></div>
              <div class="col-sm-6 smallpad"><button type="button" class="btn btn-primary btn-block" id="runlots" onclick={() => (rows = buildData(10000))}>Create 10,000 rows</button></div>
              <div class="col-sm-6 smallpad"><button type="button" class="btn btn-primary btn-block" id="add" onclick={() => (rows = rows.concat(buildData(1000)))}>Append 1,000 rows</button></div>
              <div class="col-sm-6 smallpad"><button type="button" class="btn btn-primary btn-block" id="update" onclick={() => (rows = rows.map((r, i) => (i % 10 ? r : { id: r.id, label: r.label + ' !!!' })))}>Update every 10th row</button></div>
              <div class="col-sm-6 smallpad"><button type="button" class="btn btn-primary btn-block" id="clear" onclick={() => (rows = [])}>Clear</button></div>
              <div class="col-sm-6 smallpad"><button type="button" class="btn btn-primary btn-block" id="swaprows" onclick={swap}>Swap Rows</button></div>
            </div>
          </div>
        </div>
      </div>
      <table class="table table-hover table-striped test-data">
        <tbody>
          {rows.map((row) => (
            <tr key={row.id} class={if (row.id === selected) 'danger'}>
              <td class="col-md-1">{row.id}</td>
              <td class="col-md-4"><a onclick={() => (selected = row.id)}>{row.label}</a></td>
              <td class="col-md-1"><a onclick={() => (rows = rows.filter((r) => r !== row))}><span class="glyphicon glyphicon-remove" aria-hidden="true"></span></a></td>
              <td class="col-md-6"></td>
            </tr>
          ))}
        </tbody>
      </table>
      <span class="preloadicon glyphicon glyphicon-remove" aria-hidden="true"></span>
    </div>
  );
}

route GET / {
  return (
    <html lang="en">
      <head>
        <meta charset="utf-8" />
        <title>goal.js-"keyed"</title>
        <link href="/css/currentStyle.css" rel="stylesheet" />
      </head>
      <body>
        <div id="main"><Main /></div>
      </body>
    </html>
  );
}
